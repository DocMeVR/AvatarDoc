msgid "ad.ui.add_from.poiyomi"
msgstr "Poiyomi"

msgid "ad.ui.add_from.mark"
msgstr "Mark as animated for Poiyomi's lock"

msgid "ad.ui.add_from.mark.tip"
msgstr "Marks the property Animated (when locked) on this mesh's Poiyomi materials that do not mark it yet, so it still changes in game after Poiyomi locks them at upload."

msgid "ad.ui.add_from.renamed"
msgstr "Marked Renamed: once Poiyomi locks the material, it animates \"{0}\" as \"{1}\". AvatarDoc writes both names."

msgid "ad.ui.add_from.baked"
msgstr "{1} Poiyomi materials of this mesh ({2}) are locked with \"{0}\" fixed at its value, so a change does nothing in game. Unlock them, mark the property Animated (when locked), then lock them again or let Poiyomi lock them at upload."

msgid "ad.ui.add_from.baked.one"
msgstr "The Poiyomi material \"{2}\" is locked with \"{0}\" fixed at its value, so a change does nothing in game. Unlock it, mark the property Animated (when locked), then lock it again or let Poiyomi lock it at upload."

