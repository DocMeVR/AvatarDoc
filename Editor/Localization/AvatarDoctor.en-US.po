msgstr ""
"Language: en-US\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "ad.info.path_created"
msgstr "AvatarDoc created the submenu \"{0}\" for the install path of {1}."

msgid "ad.info.same_submenu_merged"
msgstr "\"{0}\" joins the submenu of the same name that is already in the menu. ({1})"

msgid "ad.info.menu_split"
msgstr "The submenu \"{0}\" has more controls than VRChat allows on one page; the extra controls were moved to a \"More\" page. Move some controls into their own submenu to avoid the extra page."

msgid "ad.warn.orphan_entry"
msgstr "The entry \"{0}\" pointed at a submenu that no longer exists, so it was placed at the top of its component instead. Move it into a submenu that exists, or leave it here. ({1})"

msgid "ad.warn.target_missing"
msgstr "\"{0}\" has a missing target: an object, renderer, material slot or blend shape it pointed at is gone, so that row was skipped. Open \"{0}\" and fix or remove the empty target row. ({1})"

msgid "ad.warn.target_outside_avatar"
msgstr "\"{0}\" targets an object that is not part of this avatar, so that target was skipped. Pick a target that is part of this avatar. ({1})"

msgid "ad.warn.duplicate_entry_id"
msgstr "The entry \"{0}\" shares its internal id with another entry (usually a copied component). Both still work; the inspector will assign a new id. ({1})"

msgid "ad.info.parameter_reused"
msgstr "\"{0}\" already exists on the avatar, so its own saved, synced and default settings apply. ({1})"

msgid "ad.info.target_shared"
msgstr "{0} is changed by more than one control ({1}); the one built later wins: later menu entries first, triggers after every menu control. ({2})"

msgid "ad.info.target_shared_override"
msgstr "\"{0}\" is written by {1}; the override wins over every control, whatever the menu order. ({2})"

msgid "ad.warn.no_effects"
msgstr "\"{0}\" has no targets, so nothing was generated for it. Add an object, blend shape or other target with \"+ Add\". ({1})"

msgid "ad.warn.group_multiple_defaults"
msgstr "The exclusive group \"{0}\" has more than one toggle set as default; \"{1}\" is used because it comes first. Turn off \"Default on\" on the others. ({2})"

msgid "ad.error.group_value_conflict"
msgstr "The exclusive group \"{0}\" has two toggles with the value {1}. Change one of the values, or select one of the toggles and press \"Give each member its own value\". ({2})"

msgid "ad.error.parameter_type_conflict"
msgstr "The parameter \"{0}\" is already {1} here, but this control needs a {2} parameter. Pick a different name, or match the type. ({3})"

msgid "ad.error.bits_exceeded"
msgstr "Synced parameters need {0} bits but VRChat allows {1}. AvatarDoc adds {2} of them. Turn off \"Synced\" on toggles that do not need to sync, or remove some."

msgid "ad.warn.bits_exceeded_vrcfury"
msgstr "Synced parameters need {0} bits but VRChat allows {1}. AvatarDoc adds {2} of them. VRCFury is installed and compresses parameters at upload until they fit, so the build goes on. To fit without VRCFury's help, turn off \"Synced\" on toggles that do not need to sync, or remove some."

msgid "ad.error.menu_icon_too_large"
msgstr "The icon on \"{0}\" is {1}x{2} pixels or is not compressed, and VRChat's upload check rejects that. Re-import it at 256x256 pixels or smaller with compression turned on."

msgid "ad.warn.write_defaults_mixed"
msgstr "Your avatar's own FX layers mix Write Defaults on and off: on in {0}, off in {1}. Make every layer use the same setting; AvatarDoc otherwise builds with Write Defaults on."

msgid "ad.error.no_fx_layer"
msgstr "The avatar has no FX playable layer, so AvatarDoc has nowhere to add toggles. Add an FX controller under \"Playable Layers\" in the avatar's VRC Avatar Descriptor."

msgid "ad.info.curve_overwritten"
msgstr "The animation \"{0}\" also moves something \"{1}\" moves, so while that trigger is on, the trigger's own value shows there."

msgid "ad.warn.marker_clip_skipped"
msgstr "Clip \"{0}\" is one of VRChat's own proxy animations, so \"{1}\" left it alone and does not follow the shape while it plays. This is expected and needs no fix."

msgid "ad.warn.trigger_source_missing"
msgstr "The trigger \"{0}\" refers to a toggle, parameter, or blend shape that no longer exists, so it was skipped. Pick a source under \"When\" for it. ({1})"

msgid "ad.warn.parameter_type_unknown"
msgstr "The trigger \"{1}\" reads the parameter \"{0}\", but nothing on this avatar declares it, so it is treated as a Float. Declare \"{0}\" under Parameters with its real type if it should be a whole number or true/false."

msgid "ad.warn.link_effect_is_source"
msgstr "\"{0}\" lists its own shape \"{1}\" as one of its effects, so that effect is ignored. Remove \"{1}\" from its effects list."

msgid "ad.info.parameter_animator_only"
msgstr "\"{0}\" already exists in the avatar's animator, so this control drives it without adding a new parameter, but it will not sync to other players over the network. Declare \"{0}\" under Parameters if you need it to sync. ({1})"

msgid "ad.warn.replace_kept_source"
msgstr "\"{0}\" is set to Replace but has no effect it can build, so the shape's own curve in the clip \"{1}\" was kept. Add an effect to the trigger, or set its Mode to Add."

msgid "ad.info.override_applied"
msgstr "Override \"{0}\" holds \"{1}\" at its value in {2} animations."

msgid "ad.info.override_applied.one"
msgstr "Override \"{0}\" holds \"{1}\" at its value in {2} animation."

msgid "ad.warn.override_unused"
msgstr "Override \"{0}\" found no animation that moves \"{1}\" on this avatar, so it only set the mesh's own value. Check that \"{1}\" and its renderer are the ones you meant, or remove this override if that is all you wanted. ({2})"

msgid "ad.warn.override_conflict"
msgstr "Overrides \"{0}\" and \"{1}\" both hold \"{2}\" at different values; \"{1}\" wins because it comes later. Remove one of them, or match their values. ({3})"

msgid "ad.warn.override_target_gone"
msgstr "Override \"{0}\": its renderer no longer exists at build time, so the shape \"{1}\" was not pinned. Point it at a renderer that still exists on this avatar."

msgid "ad.error.edit_cycle"
msgstr "The change made to \"{0}\" would move its submenu into itself, so it was not applied. Pick a different \"Move to\" path for it. ({1})"

msgid "ad.warn.edit_own_entry"
msgstr "The change made to \"{0}\" points at an AvatarDoc entry, so it was ignored. Edit \"{0}\" directly in its own panel instead. ({1})"

msgid "ad.warn.edit_source_missing"
msgstr "The change saved for \"{0}\" cannot apply: that menu item was no longer found, so nothing changed. Use \"Remove\" to clear this edit."

msgid "ad.warn.preset_empty"
msgstr "Preset \"{0}\" sets nothing yet, so pressing it does nothing. Add a control or parameter with \"+ Add\"."

msgid "ad.warn.preset_target_missing"
msgstr "The preset \"{0}\" refers to a control that no longer exists, so that row was skipped. Remove that row from the preset. ({1})"

msgid "ad.info.preset_pick_control"
msgstr "A row of the preset \"{0}\" has no control yet, so it sets nothing. Pick a control with the row's button, or remove the row. ({1})"

msgid "ad.error.preset_group_conflict"
msgstr "The preset \"{0}\" turns on two members of the exclusive group \"{1}\" at once, but only one can be on; only the first listed is applied, and the upload stops until you fix it. Remove one of them from the preset. ({2})"

msgid "ad.warn.preset_parameter_unknown"
msgstr "The parameter \"{0}\" set by the preset \"{1}\" is not declared in the expression parameters or the FX controller, so it is written anyway. Declare \"{0}\" under Parameters if you want VRChat to recognise it. ({2})"

msgid "ad.warn.property_missing"
msgstr "\"{0}\": no material on \"{1}\" has the property \"{2}\", so that row was skipped. Pick a property that exists on \"{1}\"'s materials."

msgid "ad.warn.property_differs"
msgstr "\"{0}\": the materials on \"{1}\" already disagree on \"{2}\". Turning it off writes the first material's value to all of them, except Poiyomi materials that rename it, which keep their own in game; edit the materials first if you want a different one used."

msgid "ad.warn.poiyomi_not_animated"
msgstr "\"{0}\": {3} Poiyomi materials on \"{2}\" ({4}) do not mark \"{1}\" as animated, so Poiyomi fixes it at its value when it locks them at upload, and the change does nothing in game. Select \"{0}\" and press \"Mark as animated\", or right-click the property in each material and choose Animated (when locked)."

msgid "ad.warn.poiyomi_not_animated.one"
msgstr "\"{0}\": the Poiyomi material \"{4}\" on \"{2}\" does not mark \"{1}\" as animated, so Poiyomi fixes it at its value when it locks the material at upload, and the change does nothing in game. Select \"{0}\" and press \"Mark as animated\", or right-click the property in the material and choose Animated (when locked)."

msgid "ad.warn.poiyomi_baked"
msgstr "\"{0}\": {3} Poiyomi materials on \"{2}\" ({4}) are locked with \"{1}\" fixed at its value, so the change does nothing in game. Unlock them, right-click the property in each and choose Animated (when locked), then lock them again or let Poiyomi lock them at upload."

msgid "ad.warn.poiyomi_baked.one"
msgstr "\"{0}\": the Poiyomi material \"{4}\" on \"{2}\" is locked with \"{1}\" fixed at its value, so the change does nothing in game. Unlock the material, right-click the property and choose Animated (when locked), then lock it again or let Poiyomi lock it at upload."

msgid "ad.info.blend_ignored_in_group"
msgstr "\"{0}\" is in an exclusive group, so its blend time is not used."

msgid "ad.warn.animation_proxy"
msgstr "\"{0}\": the clip \"{1}\" is one of VRChat's own proxy clips, so it was not merged. This is expected and needs no fix."

msgid "ad.info.animation_overridden"
msgstr "\"{0}\": {1} generated values replace the same curve in its custom animation."

msgid "ad.info.animation_overridden.one"
msgstr "\"{0}\": {1} generated value replaces the same curve in its custom animation."

msgid "ad.warn.animation_binding_missing"
msgstr "\"{0}\": {1} values in its custom animation do not match anything on this avatar, so they were left out of the off state. Check that clip's object paths and properties are correct."

msgid "ad.warn.animation_binding_missing.one"
msgstr "\"{0}\": {1} value in its custom animation does not match anything on this avatar, so it was left out of the off state. Check that clip's object paths and properties are correct."

msgid "ad.import.note.unsupported_action"
msgstr "The action \"{0}\" was not carried over."

msgid "ad.import.note.transition"
msgstr "The toggle's transition animation was not carried over."

msgid "ad.import.note.security"
msgstr "The toggle's security lock was not carried over."

msgid "ad.import.note.separate_local"
msgstr "The toggle's separate local state was not carried over."

msgid "ad.import.note.hold_button"
msgstr "The toggle's hold button behaviour was not carried over."

msgid "ad.import.note.invert_rest_logic"
msgstr "The toggle's inverted rest logic was not carried over."

msgid "ad.import.note.extra_tags"
msgstr "Only \"{1}\" became the exclusive group; the other tags ({0}) were dropped."

msgid "ad.import.note.clip_paths"
msgstr "The clip's paths are used as they are. VRCFury may have rewritten them at build time, so check that they start at the avatar root."

msgid "ad.import.note.shape_changer_delete"
msgstr "The blend shape \"{0}\" is deleted by Modular Avatar; deleting a shape cannot be carried over."

msgid "ad.import.note.reactive_inverted"
msgstr "Modular Avatar's Inverted option on \"{0}\" cannot be carried over; that reaction was skipped."

msgid "ad.import.note.slot_missing"
msgstr "A material slot that does not exist on \"{0}\" was skipped."

msgid "ad.import.reason.no_supported_action"
msgstr "None of this item's actions could be carried over."

msgid "ad.import.reason.ma_merge_animator"
msgstr "This item's effects come from an animator Modular Avatar merges from \"{0}\". AvatarDoc reads such a controller only when it is set and its layer type is FX. You can still rename, move, re-icon or hide the item."

msgid "ad.import.reason.nothing_here"
msgstr "This item comes from a menu asset or a component that AvatarDoc cannot convert. You can still rename, move, re-icon or hide it."

msgid "ad.import.reason.nothing_under"
msgstr "Nothing under this submenu can be converted."

msgid "ad.import.reason.not_a_toggle"
msgstr "This Modular Avatar menu item is not a Toggle."

msgid "ad.import.reason.edit_locked"
msgstr "A locked component holds a menu edit for this item. Unlock it or remove the edit first."

msgid "ad.import.note.fx_path_missing"
msgstr "A curve's path does not resolve on this avatar; it was skipped."

msgid "ad.import.reason.property_partial"
msgstr "The material property \"{0}\" is only partly animated, so it could not be carried over."

msgid "ad.import.reason.fx_no_layer"
msgstr "This control's parameter does not drive any FX layer."

msgid "ad.import.reason.fx_parameter_shared"
msgstr "The parameter \"{0}\" is used by more than one layer, or elsewhere as a blend tree, motion time or speed parameter."

msgid "ad.import.reason.fx_other_condition"
msgstr "A transition into the on state also checks another parameter, so it could not be carried over."

msgid "ad.import.reason.fx_no_on_state"
msgstr "The layer has no state reachable on this parameter."

msgid "ad.import.reason.fx_blend_tree"
msgstr "The on state's motion is a blend tree, which cannot be carried over."

msgid "ad.import.reason.fx_no_motion"
msgstr "The on state has no motion."

msgid "ad.import.reason.fx_unsupported_curve"
msgstr "The curve \"{0}\" on {1} could not be carried over."

msgid "ad.warn.removed_layer_missing"
msgstr "The layer \"{0}\" was already removed or renamed in the FX controller, so there was nothing here to remove. If you renamed it, update the name under \"Layers left out of the build\". ({1})"

msgid "ad.import.reason.shared_layer"
msgstr "The layer switches between several states on this parameter, so it cannot be converted one control at a time."

msgid "ad.import.reason.shared_parameter_controls"
msgstr "Other menu controls use the same parameter."

msgid "ad.import.reason.behaviours"
msgstr "The layer has state behaviours that a converted toggle would lose."

msgid "ad.import.reason.layer_control"
msgstr "The avatar uses animator layer control, which refers to layers by position, so layers cannot be removed safely."

msgid "ad.import.reason.layer_masked"
msgstr "The layer has a mask or a weight of zero."

msgid "ad.import.reason.transition_chain"
msgstr "The layer plays a transition animation between off and on."

msgid "ad.import.reason.already_converted"
msgstr "This layer was already converted."

msgid "ad.import.reason.layer_name_not_unique"
msgstr "Several layers share this name, so the old one cannot be left out safely."

msgid "ad.import.reason.off_values_differ"
msgstr "The old off state sets values that a toggle cannot reproduce."

msgid "ad.import.reason.inverted_default_mismatch"
msgstr "The layer rests in its on state but the parameter does not default to true, so what it should rest on could not be told."

msgid "ad.import.reason.group_needs_removal"
msgstr "This set replaces a Merge Animator, so its originals have to be removed with it."

msgid "ad.import.note.osc"
msgstr "Anything outside the avatar that set the old parameter, such as an OSC app, has to use the new one."

msgid "ad.import.reason.radial_shape"
msgstr "The layer is not one blend tree of two constant clips at 0 and 1 on this parameter, so it could not be carried over."

msgid "ad.import.reason.radial_bindings"
msgstr "The two ends of the blend tree animate different things, so they could not be carried over."

msgid "ad.import.reason.synced_layer"
msgstr "Another layer copies this one's states, so it cannot be left out of the build safely."

msgid "ad.import.reason.ma_renamed_parameters"
msgstr "Modular Avatar renames the parameter \"{0}\" at build time, so the names inside the merged animator would no longer match what gets declared. Nothing of this set can be converted."

msgid "ad.import.note.merge_converted"
msgstr "The merged animator layer \"{0}\" became this entry's own effects."

msgid "ad.import.note.merge_parameter_control"
msgstr "This item keeps the parameter \"{0}\" and stays driven by the merged animator: {1}"

msgid "ad.import.note.merge_button"
msgstr "A Button is momentary, which an entry cannot reproduce."

msgid "ad.warn.removed_layer_ambiguous"
msgstr "\"{0}\" was not removed because {1} layers share that same name, so removing by name would take all of them. Give the FX controller's layers unique names, then build again. ({2})"

msgid "ad.import.note.driven_elsewhere"
msgstr "Another layer drives this parameter; that keeps working."

msgid "ad.import.note.ma_radio_set"
msgstr "These items share the parameter \"{0}\", so they convert together as one exclusive group where only one can be on."

msgid "ad.import.reason.driven_elsewhere"
msgstr "Another layer of this animator writes the parameter \"{0}\", and that layer stays merged."

msgid "ad.import.note.off_values"
msgstr "The old off state sets values of its own; they were carried over as this toggle's off values."

msgid "ad.warn.removed_layer_unsafe"
msgstr "The layer \"{0}\" and its parameter were kept because another controller in the build switches FX layers by their position, and removing one would shift the rest. Remove that layer control behaviour first if you still want \"{0}\" gone, then build again."

msgid "ad.warn.converted_layer_unsafe"
msgstr "Layer \"{0}\" was not removed because the avatar uses animator layer control, and removing a layer would shift the ones after it by position. Remove that layer control first if you still want \"{0}\" gone, then build again. ({1})"

msgid "ad.info.removed_parameter"
msgstr "\"{0}\" left the expression parameters and freed {1} synced bits."

msgid "ad.info.removed_parameter.one"
msgstr "\"{0}\" left the expression parameters and freed {1} synced bit."

msgid "ad.info.removed_kept"
msgstr "\"{0}\" stays in the expression parameters: {1}"

msgid "ad.removal.kept.control"
msgstr "another menu control uses it"

msgid "ad.removal.kept.entry"
msgstr "an AvatarDoc entry uses it"

msgid "ad.removal.kept.layer"
msgstr "an animator layer that stays reads it"

msgid "ad.removal.kept.other_controller"
msgstr "another animator of this avatar reads it"

msgid "ad.removal.kept.driver"
msgstr "a parameter driver writes it"

msgid "ad.removal.kept.contact"
msgstr "a contact receiver or a PhysBone writes it"

msgid "ad.removal.kept.other_tool"
msgstr "another tool on the avatar uses it"

msgid "ad.removal.kept.builtin"
msgstr "VRChat owns this parameter"

msgid "ad.error.contact_no_anchor"
msgstr "The trigger \"{0}\" has no object set for \"Anchor\", so its contact has nowhere to attach. Pick an object for \"Anchor\". ({1})"

msgid "ad.error.contact_no_tags"
msgstr "The trigger \"{0}\" has no tags ticked under \"Touched by\", so nothing can touch it. Tick at least one tag. ({1})"

msgid "ad.error.contact_nobody"
msgstr "The trigger \"{0}\" has both \"Self\" and \"Others\" off, so its contact can never fire. Turn on \"Self\", \"Others\", or both. ({1})"

msgid "ad.error.physbone_missing"
msgstr "The trigger \"{0}\" has no PhysBone chosen, so it has nothing to watch. Pick a PhysBone in its \"PhysBone\" field. ({1})"

msgid "ad.error.flip_target"
msgstr "The trigger \"{0}\" cannot flip its \"Toggle\": none is picked, or the one picked is not a toggle. Pick a toggle for it to flip. ({1})"

msgid "ad.error.touch_parameter_type"
msgstr "\"{0}\": the parameter \"{1}\" needs to be {2} here, but the avatar already has it as {3}. Rename the PhysBone's parameter, or match the type. ({4})"

msgid "ad.error.touch_outside_avatar"
msgstr "\"{0}\": its \"Anchor\" object or PhysBone belongs to another avatar. Pick one that is part of this avatar."

msgid "ad.error.contact_start_no_head"
msgstr "This avatar has no \"Head\" bone yet. Set its Animator to Humanoid and assign an Avatar, then try the start again."

msgid "ad.warn.follow_distance_one_contact"
msgstr "Fade on \"{0}\" reads only the card its first contact is in: that contact drives the fade and the rest of that card are requirements. The conditions in its other cards are kept but not used; move what you need into the first card with + And, or remove the other cards. ({1})"

msgid "ad.warn.follow_distance_no_follows"
msgstr "\"{0}\": Follows cannot fade with distance and is not built in Follow distance. Switch to Hold to use it. ({1})"

msgid "ad.warn.follow_distance_tracking_left_to"
msgstr "{0} is left to \"{1}\", which already sets it to Animation. AvatarDoc's own pause layer was not built here."

msgid "ad.warn.physbone_renamed"
msgstr "\"{0}\" watches the PhysBone \"{1}\", but Modular Avatar renames its parameter at build, so the trigger would watch the old name. Give \"{1}\" a parameter that Modular Avatar does not rename. ({2})"

msgid "ad.info.group_default_excluded"
msgstr "The default of group \"{0}\" is not built on this platform, so nothing in it is on by default here."

msgid "ad.warn.merge_no_controller"
msgstr "This merged animator has no \"Controller\" set, so nothing was merged from it. Pick a controller in its \"Controller\" field. ({0})"

msgid "ad.warn.merge_override_no_controller"
msgstr "The merged animator \"{0}\" is an Animator Override Controller whose own \"Controller\" field is empty, so it has nothing to merge and was left out. Set that field on \"{0}\", or pick a different animator. ({1})"

msgid "ad.warn.merge_skip_missing"
msgstr "\"{1}\" has no layer named \"{0}\" to leave out, so that entry under \"Layers\" does nothing. Remove it, or fix the spelling to match a real layer. ({2})"

msgid "ad.error.merge_outside_avatar"
msgstr "The merged animator \"{0}\" has its \"Path root\" set to an object outside this avatar, so it was not merged. Point \"Path root\" at an object on this avatar, or leave it empty. ({1})"

msgid "ad.error.explicit_off_pin"
msgstr "The toggle \"{0}\" turns on \"Set a value when off\" for the blend shape \"{1}\", but that shape's effect is set to \"Pin\", which writes nothing while off. Turn off \"Set a value when off\", or change \"{1}\" away from \"Pin\". ({2})"

msgid "ad.error.merge_parameter_type"
msgstr "The merged animator \"{0}\" needs the parameter \"{1}\" as {2}, but the avatar already has it as {3}. Match the type or rename one of them. ({4})"

msgid "ad.error.merge_synced_layer"
msgstr "Animator \"{0}\": the layer \"{1}\" is synced to \"{2}\", but \"{2}\" is left out of the merge. Include \"{2}\" too, or turn off the layer sync in the controller. ({3})"

msgid "ad.error.merge_layer_control"
msgstr "The merged animator \"{0}\" changes layer weights itself, so leaving layers out of it would point those changes at the wrong layer. Merge every layer, or remove the layer control. ({1})"

msgid "ad.warn.parameter_control_unused"
msgstr "\"{0}\" drives the parameter \"{1}\", but nothing on this avatar reads it, so it has no effect yet. Remove it, or point it at a parameter a merged animator, VRCFury or Modular Avatar actually uses. ({2})"

msgid "ad.info.flip_target_excluded"
msgstr "\"{0}\": its toggle is not built on this platform, so the touch does nothing here."

msgid "ad.warn.platform_parity"
msgstr "This avatar and \"{0}\" share a blueprint but their parameters differ at position {1}: \"{2}\" here, \"{3}\" there, so other platforms would see the wrong toggles. Rebuild both platforms from the same menu order to fix it."

msgid "ad.error.gate_target"
msgstr "The trigger \"{0}\" needs a toggle for \"Only while\", but the one picked is missing, a preset, or the toggle this trigger already flips. Pick a different toggle for \"Only while\". ({1})"

msgid "ad.info.hidden_toggle_unreachable"
msgstr "\"{0}\" has no menu button, so nothing can turn it on unless something else drives it. Turn on \"Default on\", add it to a preset, or add a trigger that flips it. ({1})"

