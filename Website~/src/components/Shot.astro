---
import { getImage } from 'astro:assets';
import { Zoom } from 'starlight-image-zoom/components';
import { altProblem } from '../../scripts/lib/shots.mjs';

interface Props { name: string; alt: string; caption?: string }
const { name, alt, caption } = Astro.props;

const problem = altProblem(alt);
if (problem) throw new Error(`Shot "${name}": ${problem}`);

const keyOf = (path: string) => path.replace(/^.*\/assets\/shots\//, '').replace(/\.(png|json)$/, '');
const images = Object.fromEntries(
  Object.entries(import.meta.glob('../assets/shots/**/*.png', { eager: true })).map(([p, m]) => [keyOf(p), m as { default: ImageMetadata }]),
);
const markerFiles = Object.fromEntries(
  Object.entries(import.meta.glob('../assets/shots/**/*.json', { eager: true }))
    .filter(([p]) => !p.endsWith('/manifest.json'))
    .map(([p, m]) => [keyOf(p), (m as any).default]),
);

const image = images[name];
const info = markerFiles[name];
const missing = !image;
if (missing && process.env.DOCS_ALLOW_MISSING_SHOTS !== '1') {
  throw new Error(`Shot "${name}" not found in src/assets/shots. Capture it (DocsShots tests) or fix the name.`);
}
const markers: { n: number; x: number; y: number; w: number; h: number }[] = info?.markers ?? [];
const width = info?.width ?? image?.default.width ?? 360;
const height = info?.height ?? image?.default.height ?? 200;
const picture = image ? await getImage({ src: image.default, format: 'png' }) : undefined;
---
<figure class="shot">
  {missing ? (
    <div class="shot-missing">Picture not captured yet: {name}</div>
  ) : (
    <div class="shot-frame" style={`max-width:${width}px`}>
      <Zoom label={alt}>
        <svg viewBox={`0 0 ${width} ${height}`} width={width} height={height} role="img" aria-label={alt}>
          <title>{alt}</title>
          <image href={picture!.src} width={width} height={height} />
          {markers.map((m) => (
            <rect x={m.x} y={m.y} width={m.w} height={m.h} fill="none" stroke="#f50057" stroke-width="2" vector-effect="non-scaling-stroke" />
          ))}
          {markers.map((m) => (
            <g>
              <circle cx={m.x} cy={m.y} r="9" fill="#f50057" />
              <text x={m.x} y={m.y} fill="#fff" font-size="12" font-weight="700" text-anchor="middle" dominant-baseline="central">{m.n}</text>
            </g>
          ))}
        </svg>
      </Zoom>
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot { margin: 1.5rem 0; }
  .shot-frame { display: block; width: 100%; }
  .shot-frame :global(starlight-image-zoom-zoomable) { display: block; width: auto; }
  .shot-frame :global(svg) { display: block; width: 100%; height: auto; border: 1px solid var(--sl-color-gray-5); border-radius: 4px; }
  .shot-missing {
    box-sizing: border-box; width: 360px; max-width: 100%; padding: 2rem 1rem; text-align: center;
    border: 2px dashed var(--sl-color-gray-4); color: var(--sl-color-gray-3); border-radius: 4px;
  }
  figcaption { margin-top: 0.5rem; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
</style>
